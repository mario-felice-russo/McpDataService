@page
@model McpDataService.Pages.ConfigModel
@{
    ViewData["Title"] = "Configurazione";
}

<h1>Configurazione</h1>

<div class="row">
    <div class="col-md-12">
        <div class="card mb-4">
            <div class="card-header">
                <h5>Utenti</h5>
            </div>
            <div class="card-body">
                <p class="text-muted mb-2">Password salvate in hash PBKDF2-SHA256. Nessuna password in chiaro.</p>
                <form id="users-form"
                      class="row g-2 align-items-end mb-3"
                      hx-post="/api/config/users/upsert"
                      hx-target="#users-message"
                      hx-swap="innerHTML"
                      hx-on::after-request="if(event.detail.successful){window.location.reload();}">
                    <input type="hidden" name="originalUsername" id="users-original-username" />
                    <div class="col-md-2">
                        <label class="form-label" for="users-username">Username</label>
                        <input id="users-username" type="text" class="form-control" name="username" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="users-role">Ruolo</label>
                        <select id="users-role" class="form-select" name="role">
                            @foreach (var role in Model.SupportedRoles)
                            {
                                <option value="@role">@AdminUiAuthService.GetRoleLabel(role)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="users-password">Password</label>
                        <input id="users-password" type="password" class="form-control" name="password" minlength="10" required />
                        <small id="users-password-help" class="text-muted">Minimo 10 caratteri.</small>
                    </div>
                    <div class="col-md-4">
                        <button id="users-submit-button" type="submit" class="btn btn-primary col-md-5 col-12">Salva</button>
                        <button id="users-cancel-edit-button" type="button" class="btn btn-outline-secondary col-md-5 col-12 d-none">Annulla modifica</button>
                    </div>
                </form>
                <span id="users-message"></span>
                <p class="text-muted small mb-2">Clicca una riga della tabella utenti per modificarla.</p>

                @if (Model.UiUsers.Any())
                {
                    <div class="table-responsive mt-3">
                        <table class="table table-striped table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Ruolo</th>
                                    <th>Username</th>
                                    <th>Creato</th>
                                    <th>Azioni</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.UiUsers)
                                {
                                    var normalizedRole = AdminUiAuthService.NormalizeRole(user.Role);
                                    var roleLabel = AdminUiAuthService.GetRoleLabel(normalizedRole);
                                    var roleIcon = AdminUiAuthService.GetRoleIconPath(normalizedRole);
                                    var isCurrentUser = string.Equals(user.Username, Model.CurrentUsername, StringComparison.OrdinalIgnoreCase);
                                    <tr class="ui-user-row" data-username="@user.Username" data-role="@normalizedRole" style="cursor: pointer;">
                                        <td>
                                            <span class="d-inline-flex align-items-center gap-2">
                                                <img src="@roleIcon" alt="@roleLabel" width="18" height="18" />
                                                <span>@roleLabel</span>
                                            </span>
                                        </td>
                                        <td>@user.Username</td>
                                        <td>@user.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td>
                                            @if (isCurrentUser)
                                            {
                                                <span class="text-muted">Utente corrente</span>
                                            }
                                            else
                                            {
                                                <form hx-post="/api/config/users/delete"
                                                      hx-target="#users-message"
                                                      hx-swap="innerHTML"
                                                      hx-on::after-request="if(event.detail.successful){window.location.reload();}">
                                                    <input type="hidden" name="username" value="@user.Username" />
                                                    <button type="submit" class="btn btn-sm btn-danger" hx-confirm="Eliminare utente @user.Username?">
                                                        Elimina
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        Nessun utente configurato: usa il form sopra per crearne uno.
                    </div>
                }
            </div>
        </div>
        <div class="card mb-4">
            <div class="card-header">
                <h5>Chiavi API applicative</h5>
            </div>
            <div class="card-body">
                <p class="text-muted mb-2">
                    Tutte le API richiedono gli header <code>@Model.ApplicationHeaderName</code> e <code>@Model.KeyHeaderName</code>.
                </p>
                <form class="row g-2 align-items-end mb-3"
                      hx-post="/api/config/apikeys/generate"
                      hx-target="#keys-message"
                      hx-swap="innerHTML"
                      hx-on::after-request="if(event.detail.successful){window.location.reload();}">
                    <div class="col-md-8">
                        <label class="form-label" for="api-application-name">Nome applicazione</label>
                        <input id="api-application-name" type="text" class="form-control" name="applicationName" placeholder="Es. asse-batch-import" required />
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary w-100">Genera chiave</button>
                    </div>
                </form>
                <span id="keys-message"></span>

                @if (Model.ApiClients.Any())
                {
                    <div class="table-responsive mt-3">
                        <table class="table table-striped table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Applicazione</th>
                                    <th>Chiave</th>
                                    <th>Creata</th>
                                    <th>Azioni</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.ApiClients.Count; i++)
                                {
                                    var client = Model.ApiClients[i];
                                    var fieldId = $"api-key-{i}";
                                    <tr>
                                        <td>@client.ApplicationName</td>
                                        <td style="min-width: 320px;">
                                            <div class="input-group input-group-sm">
                                                <input id="@fieldId" type="password" class="form-control" readonly value="@client.ApiKey" />
                                                <button type="button" class="btn btn-outline-secondary" onclick="toggleApiKey('@fieldId', this)">Mostra</button>
                                            </div>
                                        </td>
                                        <td>@client.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td class="d-flex gap-2">
                                            <form hx-post="/api/config/apikeys/regenerate"
                                                  hx-target="#keys-message"
                                                  hx-swap="innerHTML"
                                                  hx-on::after-request="if(event.detail.successful){window.location.reload();}">
                                                <input type="hidden" name="applicationName" value="@client.ApplicationName" />
                                                <button type="submit" class="btn btn-sm btn-warning" hx-confirm="Rigenerare la chiave per @client.ApplicationName?">
                                                    Rigenera
                                                </button>
                                            </form>
                                            <form hx-post="/api/config/apikeys/delete"
                                                  hx-target="#keys-message"
                                                  hx-swap="innerHTML"
                                                  hx-on::after-request="if(event.detail.successful){window.location.reload();}">
                                                <input type="hidden" name="applicationName" value="@client.ApplicationName" />
                                                <button type="submit" class="btn btn-sm btn-danger" hx-confirm="Eliminare la chiave per @client.ApplicationName?">
                                                    Elimina
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        Nessuna chiave configurata. Crea la prima chiave per abilitare le chiamate API da applicazioni esterne.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="card mb-6">
        <div class="card-header">
            <h5>Informazioni Servizio</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-5">Versione:</dt>
                <dd class="col-sm-7">1.0.0</dd>

                <dt class="col-sm-5">Endpoint:</dt>
                <dd class="col-sm-7">@Model.BaseUrl</dd>

                <dt class="col-sm-5">Audit DB:</dt>
                <dd class="col-sm-7">SQLite</dd>
            </dl>
        </div>
    </div>

    <div class="card mb-6">
        <div class="card-header">
            <h5>Database corrente</h5>
        </div>
        <div class="card-body">
            <form hx-post="/api/config/current-database" hx-target="#current-db-message">
                <div class="mb-3">
                    <label class="form-label" for="current-database">Database operativo predefinito</label>
                    <select id="current-database" class="form-select" name="CurrentDatabase">
                        @foreach (var database in Model.SupportedDatabases)
                        {
                            if (database == Model.CurrentDatabase)
                            {
                                <option value="@database" selected>@database</option>
                            }
                            else
                            {
                                <option value="@database">@database</option>
                            }
                        }
                    </select>
                    <small class="text-muted">Usato come default quando una richiesta non specifica <code>db_type</code>.</small>
                </div>
                <button type="submit" class="btn btn-primary">Salva Database Corrente</button>
                <span id="current-db-message"></span>
            </form>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card mb-4">
            <div class="card-header">
                <h5>Connessioni Database</h5>
            </div>
            <div class="card-body">
                <form hx-post="/api/config/connections" hx-target="#conn-message">
                    <div class="mb-3">
                        <label class="form-label" for="conn-sqlserver">SQL Server Connection String</label>
                        <input id="conn-sqlserver" type="text" class="form-control" name="SqlServer" value="@Model.SqlServerConn" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="conn-oracle">Oracle Connection String</label>
                        <input id="conn-oracle" type="text" class="form-control" name="Oracle" value="@Model.OracleConn" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="conn-sqlite">SQLite Connection String</label>
                        <input id="conn-sqlite" type="text" class="form-control" name="SQLite" value="@Model.SQLiteConn" />
                    </div>
                    <button type="submit" class="btn btn-primary">Salva Connessioni</button>
                    <span id="conn-message"></span>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card mb-4">
            <div class="card-header">
                <h5>Tray Icon</h5>
            </div>
            <div class="card-body">
                <form hx-post="/api/config/tray" hx-target="#tray-message">
                    <div class="mb-3">
                        <label class="form-label" for="tray-enabled">Stato Tray Icon</label>
                        <select id="tray-enabled" class="form-select" name="Enabled">
                            @if (Model.TrayIconEnabled)
                            {
                                <option value="true" selected>Abilitata</option>
                                <option value="false">Disabilitata</option>
                            }
                            else
                            {
                                <option value="true">Abilitata</option>
                                <option value="false" selected>Disabilitata</option>
                            }
                        </select>
                        <small class="text-muted">La modifica viene applicata subito e salvata in appsettings.json.</small>
                    </div>
                    <button type="submit" class="btn btn-primary">Salva Tray Icon</button>
                    <span id="tray-message"></span>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5>Gestione Servizio</h5>
            </div>
            <div class="card-body">
                <button class="btn btn-danger" hx-post="/api/config/shutdown" hx-confirm="Sei sicuro di voler chiudere il servizio?" hx-target="#shutdown-message">
                    Chiudi Servizio
                </button>
                <span id="shutdown-message"></span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleApiKey(fieldId, button) {
            const field = document.getElementById(fieldId);
            if (!field) {
                return;
            }

            const show = field.type === "password";
            field.type = show ? "text" : "password";
            button.textContent = show ? "Nascondi" : "Mostra";
        }

        function initUsersEditor() {
            const form = document.getElementById("users-form");
            if (!form) {
                return;
            }

            const originalUsernameInput = document.getElementById("users-original-username");
            const usernameInput = document.getElementById("users-username");
            const roleInput = document.getElementById("users-role");
            const passwordInput = document.getElementById("users-password");
            const passwordHelp = document.getElementById("users-password-help");
            const submitButton = document.getElementById("users-submit-button");
            const cancelEditButton = document.getElementById("users-cancel-edit-button");
            const userRows = document.querySelectorAll("tr.ui-user-row");

            function clearRowSelection() {
                userRows.forEach(row => row.classList.remove("table-primary"));
            }

            function setCreateMode() {
                clearRowSelection();
                originalUsernameInput.value = "";
                usernameInput.value = "";
                roleInput.value = "user";
                passwordInput.value = "";
                passwordInput.required = true;
                passwordInput.placeholder = "";
                passwordHelp.textContent = "Minimo 10 caratteri.";
                submitButton.textContent = "Salva";
                cancelEditButton.classList.add("d-none");
            }

            function setEditMode(row) {
                clearRowSelection();
                row.classList.add("table-primary");

                const selectedUsername = row.dataset.username ?? "";
                const selectedRole = row.dataset.role ?? "user";

                originalUsernameInput.value = selectedUsername;
                usernameInput.value = selectedUsername;
                roleInput.value = selectedRole;
                passwordInput.value = "";
                passwordInput.required = false;
                passwordInput.placeholder = "Lascia vuota per mantenere la password attuale";
                passwordHelp.textContent = "Opzionale in modifica: se valorizzata, deve avere almeno 10 caratteri.";
                submitButton.textContent = "Aggiorna";
                cancelEditButton.classList.remove("d-none");
            }

            userRows.forEach(row => {
                row.addEventListener("click", event => {
                    if (event.target.closest("button, a, form, input, select, textarea, label")) {
                        return;
                    }

                    setEditMode(row);
                });
            });

            cancelEditButton.addEventListener("click", () => {
                setCreateMode();
            });

            setCreateMode();
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initUsersEditor);
        } else {
            initUsersEditor();
        }
    </script>
}