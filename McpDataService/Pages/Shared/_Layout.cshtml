@{
    var title = ViewData["Title"]?.ToString();
    var fullTitle = string.IsNullOrWhiteSpace(title) ? "MCP Data Service" : $"{title} - MCP Data Service";
    var rawRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    if (string.Equals(rawRole, "AdminUi", StringComparison.OrdinalIgnoreCase))
    {
        rawRole = AdminUiAuthService.AdminRole;
    }

    var normalizedRole = AdminUiAuthService.NormalizeRole(rawRole);
    var roleLabel = AdminUiAuthService.GetRoleLabel(normalizedRole);
    var roleIconPath = AdminUiAuthService.GetRoleIconPath(normalizedRole);
    var isAdmin = User.IsInRole(AdminUiAuthService.AdminRole) || User.IsInRole("AdminUi");
    var canReadTechnical = isAdmin || User.IsInRole(AdminUiAuthService.ProgrammerRole);
}
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@fullTitle</title>
    <link rel="icon" type="image/png" href="~/images/mcp-logo.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-page="/Index">
                    <img src="~/images/mcp-logo.png" alt="MCP Data Service Logo" class="brand-logo" />
                    <span class="brand-title">MCP Data Service</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Mostra menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Home</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            if (isAdmin)
                            {
                                <li class="nav-item"><a class="nav-link" asp-page="/Config">Configurazione</a></li>
                            }

                            if (canReadTechnical)
                            {
                                <li class="nav-item"><a class="nav-link" asp-page="/Logs">Log</a></li>
                                <li class="nav-item"><a class="nav-link" asp-page="/AuditLogs">Audit</a></li>
                            }
                        }
                        <li class="nav-item"><a class="nav-link" href="/swagger" target="_blank" rel="noopener">Swagger</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="nav-link disabled d-inline-flex align-items-center gap-2">
                                    <img src="@roleIconPath" alt="@roleLabel" width="16" height="16" />
                                    <span>@roleLabel: @User.Identity?.Name</span>
                                </span>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Logout" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Login">Login</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main class="container py-4">
        <div class="page-shell">
            @RenderBody()
        </div>
    </main>
    <footer class="app-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
            <small>© @DateTime.Now.Year MCP Data Service</small>
            <small>Model Context Protocol • Multi DB Gateway</small>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
